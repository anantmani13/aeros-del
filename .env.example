# OpenAQ — PRIMARY air quality source (optional key, rate-limited without)
OPENAQ_API_KEY=
# WAQI (waqi.info) — SECONDARY fallback + independent forecast (free token)
WAQI_API_KEY=
OPENWEATHER_API_KEY=
NASA_FIRMS_API_KEY=
GEMINI_API_KEY=
MAPTILER_KEY=
# Optional: restores CARTO basemap look (CARTO raster tiles now need a free
# key or they watermark "API key required"). Get one at
# https://carto.com/basemaps/apikey/ — without it the app uses keyless
# OSM (light) / Esri (dark) tiles.
CARTO_KEY=

# Station readings older than this (hours) get a STALE badge in the UI.
# CPCB via OpenAQ normally lags 1-3h; beyond this the feed has stalled.
STALE_AFTER_HOURS=6

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Data pipeline
DATA_REFRESH_INTERVAL=300
DATABASE_PATH=data/aqi_data.db
DEMO_MODE=false

# Set true to let Gemini optionally rephrase policy advisories.
# Forecasting NEVER uses an LLM — only the template engine (off by default).
LLM_ENHANCED=false
